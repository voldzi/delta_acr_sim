        "security": [
          {
            "copRouterBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Probe performed; inspect ready and blockers. Not account deletion completion.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/ProbeNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouterErasureCapability"
                }
              }
            }
          },
          "400": {
            "description": "Unexpected query, body or actor header"
          },
          "401": {
            "description": "Invalid dedicated service bearer"
          },
          "403": {
            "description": "Browser or unapproved service"
          },
          "429": {
            "description": "Bounded probe rate limit"
          },
          "503": {
            "description": "Probe cannot be performed reliably; no fallback, cached proof or side effects"
          }
        }
      }
    },
    "/api/v1/ai-router/cop/users/me/erasure-operations/preflight": {
      "post": {
        "operationId": "proposeRouterErasurePreflight",
        "tags": [
          "Account erasure review"
        ],
        "summary": "Read-only actor-specific Router erasure preflight",
        "description": "Same dedicated bearer, seven-claim purpose actor and exact RouterErasureRequest as start. Reject query and Origin. Validate identity/operation binding and the original own operation digest if present; other-actor existing operations return the same non-disclosing 404 as hidden state. No operation creation, fence, deletion, publication, key decryption, reservation, provider call or measurement fetch. HTTP 200 means only a performed probe; ready=false is blocked, not pending deletion. Start rechecks transient readiness under actual lifecycle/financial/contributor locks. Check providerRequestsSettled only for this target's reserved/uncertain provider work. Unknown historical alias derivations block identityBindingReviewed; the signed alias must exactly match the ordinary COP BYOK/legacy identity derivation.",
        "security": [
          {
            "copRouterBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ActorHeader"
          },
          {
            "$ref": "#/components/parameters/ActorSignature"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouterErasureRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preflight performed; ready is transient and is never deletion status.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/ProbeNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouterErasurePreflight"
                }
              }
            }
          },
          "400": {
            "description": "Invalid exact body or shape/coverage; no truncation"
          },
          "401": {
            "description": "Invalid bearer or purpose actor"
          },
          "403": {
            "description": "Browser or unapproved service"
          },
          "404": {
            "description": "Existing operation is not visible; no cross-actor disclosure"
          },
          "409": {
            "description": "Own operation immutable digest conflict"
          },
          "429": {
            "description": "Bounded probe rate limit"
          },
          "503": {
            "description": "Preflight cannot be performed reliably; no bypass or writes"
          }
        }
      }
    },
    "/situation-data/api/v1/internal/driver-measurements/v1/account-erasure-operations": {
      "post": {
        "operationId": "proposeDriverAccountErasure",
        "tags": ["Account erasure review"],
        "summary": "Request or resume one COP-derived driver erasure operation",
        "description": "Existing dedicated COP measurement bearer plus purpose-bound signed actor. COP preserves its durable account fence and deletion queue and derives every retained/outbox contributor day and key version without truncation. Coverage is anchored at first acceptedAt: UTC date(acceptedAt minus eight days) through the first acceptance day, plus any next-day date permitted by the 30-second future tolerance. COP refreshes the manifest before a delayed first delivery. Retries retain the original anchor and digest. SIM cannot independently prove membership, missing key versions or manifest completeness; COP attests them. Scope is online driver storage and acknowledged derived report only. No live speed or ETA activation.",
        "security": [{ "copMeasurementBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ActorHeader" }, { "$ref": "#/components/parameters/ActorSignature" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DriverErasureRequest" } } } },
        "responses": {
          "200": { "description": "Verified named online driver scope only; never whole-account, physical-backup or provider completion", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DriverErasureCompletedReceipt" } } } },
          "202": { "description": "Pending replay, publisher, retention review, report acknowledgement or zero verification; not erased", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DriverErasurePendingReceipt" } } } },
          "400": { "description": "Invalid or incomplete manifest; no truncation" },
          "401": { "description": "Invalid bearer or purpose-bound actor" },
          "403": { "description": "Browser or unapproved service" },
          "409": { "description": "Operation identity or immutable body digest conflict" },
          "429": { "description": "Bounded service rate limit; preserve operation ID" },
          "503": { "description": "Disabled capability, unavailable storage or unsafe replay state; no bypass" }
        }
      }
    },
    "/situation-data/api/v1/internal/driver-measurements/v1/account-erasure-operations/{operationId}": {
      "get": {
        "operationId": "proposeReadDriverAccountErasure",
        "tags": ["Account erasure review"],
        "summary": "Read the durable driver erasure status without advancing it",
        "security": [{ "copMeasurementBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/OperationId" }, { "$ref": "#/components/parameters/ActorHeader" }, { "$ref": "#/components/parameters/ActorSignature" }],
        "responses": {
          "200": { "description": "Verified completed named online scope, never whole-account proof", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DriverErasureCompletedReceipt" } } } },
          "202": { "description": "Durable pending status, not a deletion acknowledgement", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DriverErasurePendingReceipt" } } } },
          "400": { "description": "Invalid ID or unexpected query" },
          "401": { "description": "Invalid bearer or actor" },
          "404": { "description": "Identical response for missing and other-actor operations; no existence disclosure" },
          "503": { "description": "Capability disabled or durable store unavailable" }
        }
      }
    },
    "/api/v1/ai-router/cop/users/me/erasure-operations": {
      "post": {
        "operationId": "proposeRouterAccountErasure",
        "tags": ["Account erasure review"],
        "summary": "Request or resume one COP namespace Router erasure operation",
        "description": "Requires COP bearer and a purpose-bound actor, independently of BYOK or external-model flags. The browser never selects target account or payer. Fence all key mutations, reservations, BYOK chat and legacy COP generate; no shared-key fallback. Already-sent provider work cannot be unsent. Pending provider reservations, retention review or restore review prevent completion. Cost carry-forward is minimalized internal evidence without direct user linkage, not automatically anonymous.",
        "security": [{ "copRouterBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ActorHeader" }, { "$ref": "#/components/parameters/ActorSignature" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RouterErasureRequest" } } } },
        "responses": {
          "200": { "description": "Verified primary-database COP namespace only; named exceptions remain", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RouterErasureCompletedReceipt" } } } },
          "202": { "description": "Erasure remains pending; does not authorize a fallback or apparent success", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RouterErasurePendingReceipt" } } } },
          "400": { "description": "Invalid exact request body" },
          "401": { "description": "Invalid bearer or purpose-bound actor" },
          "403": { "description": "Only the approved COP service may invoke this operation" },
          "409": { "description": "Operation identity conflict" },
          "429": { "description": "Bounded service rate limit; no provider bypass" },
          "503": { "description": "Disabled capability or unavailable durable store" }
        }
      }
    },
    "/api/v1/ai-router/cop/users/me/erasure-operations/{operationId}": {
      "get": {
        "operationId": "proposeReadRouterAccountErasure",
        "tags": ["Account erasure review"],
        "summary": "Read the actor-bound Router erasure status without provider calls",
        "security": [{ "copRouterBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/OperationId" }, { "$ref": "#/components/parameters/ActorHeader" }, { "$ref": "#/components/parameters/ActorSignature" }],
        "responses": {
          "200": { "description": "Verified completed named online scope, not whole-account completion", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RouterErasureCompletedReceipt" } } } },
          "202": { "description": "Durable pending status, not a deletion acknowledgement", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RouterErasurePendingReceipt" } } } },
          "400": { "description": "Invalid ID or unexpected query" },
          "401": { "description": "Invalid bearer or purpose-bound actor" },
          "404": { "description": "Identical response for missing and other-actor operations; no existence disclosure" },
          "503": { "description": "Capability disabled or durable store unavailable" }
        }
      }
    }
  },
  "components": {
    "headers": {
      "ProbeNoStore": {
        "description": "Readiness must be checked again, never served from a cache.",
        "schema": {
          "type": "string",
          "const": "no-store"
        }
      }
    },
    "securitySchemes": {
      "copMeasurementBearer": { "type": "http", "scheme": "bearer", "description": "Existing dedicated COP measurement service credential; new erasure purpose requires separate explicit approval. Never a browser credential." },
      "copRouterBearer": { "type": "http", "scheme": "bearer", "description": "Existing dedicated COP Router service credential; new erasure purpose requires separate explicit approval. No shared-key bypass." }
    },
    "parameters": {
      "OperationId": { "name": "operationId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "ActorHeader": { "name": "x-cop-actor", "in": "header", "required": true, "description": "Unpadded canonical base64url encoding of compact UTF-8 JSON with exact ordered claims iss/sub/aud/iat/exp/operationId/routerUserId matching ErasureActorClaims. Reject duplicate or unknown keys. COP derives issuer/subject from its verified session, and routerUserId with EXACT existing opaqueUserId used by ordinary BYOK actor.sub and legacy COP chat userId. Bind the operation to issuer/subject separately; target existingBudgetStore.hashUser('cop', routerUserId), never raw subject. Exact allowlisted issuer, iat <= now < exp and 0 < exp-iat <= 60 seconds; operationId matches body/path. Unknown historical derivations block preflight. Signature timing is excluded from idempotency digest. No raw subject, alias or signature is persisted in receipts or logs.", "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{20,2048}$" } },
      "ActorSignature": { "name": "x-cop-actor-signature", "in": "header", "required": true, "description": "HMAC-SHA256 of the exact encoded x-cop-actor under an approved server-only signer secret. No token, signature or actor content is logged.", "schema": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    },
    "schemas": {
      "ErasureProbeEnvelope": {
        "description": "Only an uncached read-only probe, never deletion completion. All fields are scalar operational evidence; no raw subject, contributor ID, key fingerprint, request ID or provider data.",
        "type": "object",
        "required": [
          "contractVersion",
          "owner",
          "scope",
          "enabled",
          "ready",
          "checkedAt",
          "blockers",
          "mutates",
          "providerCalls",
          "wholeAccountComplete"
        ],
        "properties": {
          "contractVersion": {
            "const": "sim-account-erasure-v1"
          },
          "owner": {
            "enum": [
              "sim_measurements",
              "ai_router"
            ]
          },
          "scope": {
            "enum": [
              "online_driver_scope",
              "cop_router_primary_database"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "ready": {
            "type": "boolean"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "blockers": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 9,
            "items": {
              "enum": [
                "erasure_disabled",
                "schema_not_ready",
                "permissions_not_ready",
                "identity_review_required",
                "restore_checkpoint_not_current",
                "retention_review_required",
                "publication_proof_required",
                "provider_requests_pending",
                "identity_binding_review_required"
              ]
            }
          },
          "mutates": {
            "const": false
          },
          "providerCalls": {
            "const": false
          },
          "wholeAccountComplete": {
            "const": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "ready": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "enabled": {
                  "const": true
                },
                "blockers": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "ready": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "blockers": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "DriverErasureServiceChecks": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaReady",
          "permissionsReady",
          "identityReviewed",
          "restoreCheckpointCurrent",
          "retentionReviewed",
          "publicationFenceVerified"
        ],
        "properties": {
          "schemaReady": {
            "type": "boolean"
          },
          "permissionsReady": {
            "type": "boolean"
          },
          "identityReviewed": {
            "type": "boolean"
          },
          "restoreCheckpointCurrent": {
            "type": "boolean"
          },
          "retentionReviewed": {
            "type": "boolean"
          },
          "publicationFenceVerified": {
            "type": "boolean"
          }
        }
      },
      "RouterErasureServiceChecks": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaReady",
          "permissionsReady",
          "identityReviewed",
          "restoreCheckpointCurrent",
          "retentionReviewed"
        ],
        "properties": {
          "schemaReady": {
            "type": "boolean"
          },
          "permissionsReady": {
            "type": "boolean"
          },
          "identityReviewed": {
            "type": "boolean"
          },
          "restoreCheckpointCurrent": {
            "type": "boolean"
          },
          "retentionReviewed": {
            "type": "boolean"
          }
        }
      },
      "DriverErasureActorChecks": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaReady",
          "permissionsReady",
          "identityReviewed",
          "restoreCheckpointCurrent",
          "retentionReviewed",
          "publicationFenceVerified",
          "identityBindingReviewed",
          "manifestShapeAndCoverageValid"
        ],
        "properties": {
          "schemaReady": {
            "type": "boolean"
          },
          "permissionsReady": {
            "type": "boolean"
          },
          "identityReviewed": {
            "type": "boolean"
          },
          "restoreCheckpointCurrent": {
            "type": "boolean"
          },
          "retentionReviewed": {
            "type": "boolean"
          },
          "publicationFenceVerified": {
            "type": "boolean"
          },
          "identityBindingReviewed": {
            "type": "boolean"
          },
          "manifestShapeAndCoverageValid": {
            "type": "boolean"
          }
        }
      },
      "RouterErasureActorChecks": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaReady",
          "permissionsReady",
          "identityReviewed",
          "restoreCheckpointCurrent",
          "retentionReviewed",
          "identityBindingReviewed",
          "providerRequestsSettled"
        ],
        "properties": {
          "schemaReady": {
            "type": "boolean"
          },
          "permissionsReady": {
            "type": "boolean"
          },
          "identityReviewed": {
            "type": "boolean"
          },
          "restoreCheckpointCurrent": {
            "type": "boolean"
          },
          "retentionReviewed": {
            "type": "boolean"
          },
          "identityBindingReviewed": {
            "type": "boolean"
          },
          "providerRequestsSettled": {
            "type": "boolean"
          }
        }
      },
      "ErasureCoverageAnchor": {
        "description": "checked_at means the current probe time for an operation not yet accepted. first_accepted_at means this actor's original stored acceptedAt for an existing operation, never the retry signature time.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "at"
        ],
        "properties": {
          "kind": {
            "enum": [
              "checked_at",
              "first_accepted_at"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        }
      },
      "DriverErasureCapability": {
        "description": "Service-wide readiness only. It does not validate any contributor manifest or authorize a deletion. Health alone cannot make any check true.",
        "allOf": [
          {
            "$ref": "#/components/schemas/ErasureProbeEnvelope"
          },
          {
            "type": "object",
            "required": [
              "checks",
              "reportProtection"
            ],
            "properties": {
              "owner": {
                "const": "sim_measurements"
              },
              "scope": {
                "const": "online_driver_scope"
              },
              "checks": {
                "$ref": "#/components/schemas/DriverErasureServiceChecks"
              },
              "reportProtection": {
                "enum": [
                  "unverified",
                  "no_report",
                  "enforced_single_writer",
                  "shared_generation_fence"
                ]
              }
            }
          },
          {
            "if": {
              "required": [
                "enabled",
                "checks",
                "reportProtection"
              ],
              "properties": {
                "enabled": {
                  "const": true
                },
                "checks": {
                  "required": [
                    "schemaReady",
                    "permissionsReady",
                    "identityReviewed",
                    "restoreCheckpointCurrent",
                    "retentionReviewed",
                    "publicationFenceVerified"
                  ],
                  "properties": {
                    "schemaReady": {
                      "const": true
                    },
                    "permissionsReady": {
                      "const": true
                    },
                    "identityReviewed": {
                      "const": true
                    },
                    "restoreCheckpointCurrent": {
                      "const": true
                    },
                    "retentionReviewed": {
                      "const": true
                    },
                    "publicationFenceVerified": {
                      "const": true
                    }
                  }
                },
                "reportProtection": {
                  "enum": [
                    "no_report",
                    "enforced_single_writer",
                    "shared_generation_fence"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "ready": {
                  "const": true
                }
              }
            },
            "else": {
              "properties": {
                "ready": {
                  "const": false
                }
              }
            }
          }
        ],
        "unevaluatedProperties": false
      },
      "RouterErasureCapability": {
        "description": "Service-wide readiness only; providerRequestsSettled is deliberately absent because this bearer-only probe has no target account.",
        "allOf": [
          {
            "$ref": "#/components/schemas/ErasureProbeEnvelope"
          },
          {
            "type": "object",
            "required": [
              "checks",
              "costPolicy"
            ],
            "properties": {
              "owner": {
                "const": "ai_router"
              },
              "scope": {
                "const": "cop_router_primary_database"
              },
              "checks": {
