                    },
                    "identityReviewed": {
                      "const": true
                    },
                    "restoreCheckpointCurrent": {
                      "const": true
                    },
                    "retentionReviewed": {
                      "const": true
                    },
                    "publicationFenceVerified": {
                      "const": true
                    },
                    "identityBindingReviewed": {
