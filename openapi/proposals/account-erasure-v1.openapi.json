      "ErasureActorClaims": {
        "description": "Decoded proposal-only actor. Raw subject is transient. COP attests routerUserId = 'cop_' + base64url(HMAC-SHA256(existingCopUserIdSecret, 'cop-router-chat-v1' + NUL + verifiedSessionSubject)). Keep ordinary four-field BYOK actor unchanged. JSON field order, duplicate-key rejection, issuer allowlist and time/operation relationships require strict decoder checks beyond schema validation.",
        "type": "object", "additionalProperties": false,
        "required": ["iss", "sub", "aud", "iat", "exp", "operationId", "routerUserId"],
        "properties": {
          "iss": { "type": "string", "format": "uri", "minLength": 1, "maxLength": 512 },
          "sub": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$" },
          "aud": { "const": "sim-account-erasure" },
          "iat": { "type": "integer", "minimum": 0 }, "exp": { "type": "integer", "minimum": 1 },
          "operationId": { "type": "string", "format": "uuid" },
          "routerUserId": { "type": "string", "pattern": "^cop_[A-Za-z0-9_-]{43}$" }
        }
      },
      "RouterErasureRequest": {
        "type": "object", "additionalProperties": false, "required": ["contractVersion", "operationId"],
        "properties": { "contractVersion": { "const": "sim-account-erasure-v1" }, "operationId": { "type": "string", "format": "uuid" } }
      },
      "DriverErasureRequest": {
        "type": "object", "additionalProperties": false, "required": ["contractVersion", "operationId", "contributors", "attestation"],
        "properties": {
          "contractVersion": { "const": "sim-account-erasure-v1" }, "operationId": { "type": "string", "format": "uuid" },
          "attestation": { "const": "cop-account-erasure-contributors-reviewed-v1" },
          "contributors": { "type": "array", "minItems": 9, "maxItems": 40, "uniqueItems": true,
            "items": { "type": "object", "additionalProperties": false, "required": ["contributorDay", "contributorIdDay"], "properties": { "contributorDay": { "type": "string", "format": "date" }, "contributorIdDay": { "type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$" } } }
          }
        }
      },
      "DriverErasureReceipt": {
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "operationId", "status", "scope", "wholeAccountComplete", "backupReplayRequired", "acceptedAt", "updatedAt", "contributorCount", "deletedBatchCount", "remainingBatchCount", "databaseZeroVerified", "derivedReportAcknowledged", "reportProtection", "publicationFenceVerified", "replayReady", "retentionReviewed", "pendingReason"],
        "properties": {
          "contractVersion": { "const": "sim-account-erasure-v1" }, "operationId": { "type": "string", "format": "uuid" }, "status": { "enum": ["pending", "completed"] }, "scope": { "const": "online_driver_scope" },
          "wholeAccountComplete": { "const": false }, "backupReplayRequired": { "const": true }, "acceptedAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" },
          "contributorCount": { "type": "integer", "minimum": 9, "maximum": 40 }, "deletedBatchCount": { "type": "integer", "minimum": 0 }, "remainingBatchCount": { "type": "integer", "minimum": 0 },
          "databaseZeroVerified": { "type": "boolean" }, "derivedReportAcknowledged": { "type": "boolean" },
          "reportProtection": { "enum": ["unverified", "no_report", "enforced_single_writer", "shared_generation_fence"], "description": "No-report requires inventory of deployed and external copies; process-local epochs or review flags alone are not publication proof." },
          "publicationFenceVerified": { "type": "boolean" }, "replayReady": { "type": "boolean" }, "retentionReviewed": { "type": "boolean" },
          "pendingReason": { "enum": [null, "replay_review_required", "publisher_review_required", "retention_review_required", "derived_report_pending", "stored_rows_remaining"] }
        },
        "allOf": [
          { "if": { "properties": { "status": { "const": "completed" } } }, "then": { "properties": { "remainingBatchCount": { "const": 0 }, "databaseZeroVerified": { "const": true }, "derivedReportAcknowledged": { "const": true }, "replayReady": { "const": true }, "retentionReviewed": { "const": true }, "publicationFenceVerified": { "const": true }, "reportProtection": { "enum": ["no_report", "enforced_single_writer", "shared_generation_fence"] }, "pendingReason": { "const": null } } } },
          { "if": { "properties": { "status": { "const": "pending" } } }, "then": { "properties": { "pendingReason": { "enum": ["replay_review_required", "publisher_review_required", "retention_review_required", "derived_report_pending", "stored_rows_remaining"] } } } }
        ]
      },
      "RouterErasureReceipt": {
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "operationId", "status", "scope", "pendingReasons", "pendingRequestCount", "onlineScopeComplete", "wholeAccountComplete", "backupsComplete", "providerRetentionComplete", "retainedMinimumReplayFence", "aliasScope"],
        "properties": {
          "contractVersion": { "const": "sim-account-erasure-v1" }, "operationId": { "type": "string", "format": "uuid" }, "status": { "enum": ["pending", "online_complete"] }, "scope": { "const": "cop_router_primary_database" },
          "pendingReasons": { "type": "array", "uniqueItems": true, "maxItems": 3, "items": { "enum": ["provider_requests_pending", "cost_retention_review_required", "backup_replay_not_ready"] } }, "pendingRequestCount": { "type": "integer", "minimum": 0 }, "onlineScopeComplete": { "type": "boolean" },
          "wholeAccountComplete": { "const": false }, "backupsComplete": { "const": false }, "providerRetentionComplete": { "const": false }, "retainedMinimumReplayFence": { "const": true }, "aliasScope": { "const": "sim_izs_not_resolved" }
        },
        "allOf": [
          { "if": { "properties": { "status": { "const": "online_complete" } } }, "then": { "properties": { "pendingRequestCount": { "const": 0 }, "pendingReasons": { "maxItems": 0 }, "onlineScopeComplete": { "const": true } } } },
          { "if": { "properties": { "status": { "const": "pending" } } }, "then": { "properties": { "pendingReasons": { "minItems": 1 }, "onlineScopeComplete": { "const": false } } } }
        ]
      },
      "DriverErasureCompletedReceipt": {
        "allOf": [{ "$ref": "#/components/schemas/DriverErasureReceipt" }, { "type": "object", "properties": { "status": { "const": "completed" } } }]
      },
      "DriverErasurePendingReceipt": {
        "allOf": [{ "$ref": "#/components/schemas/DriverErasureReceipt" }, { "type": "object", "properties": { "status": { "const": "pending" } } }]
      },
      "RouterErasureCompletedReceipt": {
        "allOf": [{ "$ref": "#/components/schemas/RouterErasureReceipt" }, { "type": "object", "properties": { "status": { "const": "online_complete" } } }]
      },
      "RouterErasurePendingReceipt": {
        "allOf": [{ "$ref": "#/components/schemas/RouterErasureReceipt" }, { "type": "object", "properties": { "status": { "const": "pending" } } }]
      }
    }
  }
}
