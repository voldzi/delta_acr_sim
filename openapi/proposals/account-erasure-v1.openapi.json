{
  "openapi": "3.1.0",
  "info": {
    "title": "SIM COP account erasure review proposal",
    "version": "0.3.0",
    "description": "Review proposal only. NOT merged into binding openapi/openapi.json, NOT a deployed or available capability. No production permission, secret, retention decision or deletion is authorized by this document. COP derives actor and all contributor identities server-side."
  },
  "servers": [{ "url": "/", "description": "Relative review context only; no available production endpoint is advertised." }],
  "x-implementation-status": "proposal_not_activated",
  "paths": {
    "/situation-data/api/v1/internal/driver-measurements/v1/account-erasure-operations/capability": {
      "get": {
        "operationId": "proposeDriverErasureCapability",
        "tags": [
          "Account erasure review"
        ],
        "summary": "Probe readiness of the named Driver erasure service scope",
        "description": "Dedicated service bearer only; no actor or account identity. Reject Origin, query, body or actor headers. Read-only, uncached, no operation, fence, deletion, key decryption, reservation, provider call or measurement fetch. Health does not imply erasure readiness. ready equals enabled AND every service check AND a reviewed policy/publication mode, with no blockers. An inability to perform the probe reliably returns 503, not a cached or optimistic result. Static paths precede the UUID status route. Account-specific checks belong only to preflight.",
        "security": [
          {
            "copMeasurementBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Probe performed; inspect ready and blockers. Not account deletion completion.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/ProbeNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriverErasureCapability"
                }
              }
            }
          },
          "400": {
            "description": "Unexpected query, body or actor header"
          },
          "401": {
            "description": "Invalid dedicated service bearer"
          },
          "403": {
            "description": "Browser or unapproved service"
          },
          "429": {
            "description": "Bounded probe rate limit"
          },
          "503": {
            "description": "Probe cannot be performed reliably; no fallback, cached proof or side effects"
          }
        }
      }
    },
    "/situation-data/api/v1/internal/driver-measurements/v1/account-erasure-operations/preflight": {
      "post": {
        "operationId": "proposeDriverErasurePreflight",
        "tags": [
          "Account erasure review"
        ],
        "summary": "Read-only actor-specific Driver erasure preflight",
        "description": "Same dedicated bearer, seven-claim purpose actor and exact DriverErasureRequest as start. Reject query and Origin. Validate identity/operation binding and the original own operation digest if present; other-actor existing operations return the same non-disclosing 404 as hidden state. No operation creation, fence, deletion, publication, key decryption, reservation, provider call or measurement fetch. HTTP 200 means only a performed probe; ready=false is blocked, not pending deletion. Start rechecks transient readiness under actual lifecycle/financial/contributor locks. For a new operation coverageAnchor.kind=checked_at and at=checkedAt; an existing own operation uses first_accepted_at and its original acceptedAt. Validate manifest shape and UTC coverage against that anchor; COP attests membership, all historical key versions and retained/outbox completeness. A preflight across UTC midnight is not durable authorization; start uses its actual first acceptedAt and may reject a now-incomplete manifest.",
        "security": [
          {
            "copMeasurementBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ActorHeader"
          },
          {
            "$ref": "#/components/parameters/ActorSignature"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DriverErasureRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preflight performed; ready is transient and is never deletion status.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/ProbeNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriverErasurePreflight"
                }
              }
            }
          },
          "400": {
            "description": "Invalid exact body or shape/coverage; no truncation"
          },
          "401": {
            "description": "Invalid bearer or purpose actor"
          },
          "403": {
            "description": "Browser or unapproved service"
          },
          "404": {
            "description": "Existing operation is not visible; no cross-actor disclosure"
          },
          "409": {
            "description": "Own operation immutable digest conflict"
          },
          "429": {
            "description": "Bounded probe rate limit"
          },
          "503": {
            "description": "Preflight cannot be performed reliably; no bypass or writes"
          }
        }
      }
    },
    "/api/v1/ai-router/cop/users/me/erasure-operations/capability": {
      "get": {
        "operationId": "proposeRouterErasureCapability",
        "tags": [
