{
  "openapi": "3.1.0",
  "info": {
    "title": "SIM canonical user data - separate source candidate",
    "version": "1.0.0",
    "description": "New twelfth clean-v2 component. Isolated tests only until joint production acceptance. CF24 and eleven-component v1 unchanged. No public browser use. Fixed internal relay only; no new public port. Completed receipts always require fresh zero content readback. Opt-in same-epoch-completed-content-replay-v1 repeats actual cleanup without resetting the original job or repeating financial rollups; it is not authorization to admit a different restore generation."
  },
  "paths": {
    "/api/v1/internal/sim-user-data/v1/capabilities": {
      "get": {
        "operationId": "getSimUserDataCapabilities",
        "summary": "Require actual main and Router component readiness",
        "security": [
          {
            "Service": []
          }
        ],
        "responses": {
          "200": {
            "description": "Fresh combined readback, never whole-account acceptance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "400": {
            "description": "Strict contract rejected"
          },
          "401": {
            "description": "Service or actor authentication failed"
          },
          "404": {
            "description": "No owner-bound operation / browser, query or unknown path"
          },
          "409": {
            "description": "Immutable operation conflict"
          },
          "503": {
            "description": "Disabled, DB/guard/Router/readback unavailable"
          }
        }
      }
    },
