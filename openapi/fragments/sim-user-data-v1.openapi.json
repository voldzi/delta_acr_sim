  "components": {
    "schemas": {
      "Request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contractVersion", "scope", "resetEpoch", "operationId", "requestedAt"],
        "properties": {
          "contractVersion": {
            "const": "cop-sim-user-data-v1"
          },
          "scope": {
            "const": "cop_sim_shared_identity_v1"
          },
          "resetEpoch": {
            "type": "string",
            "format": "uuid"
          },
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contractVersion", "component", "scope", "resetEpoch", "operationId", "state", "subcomponents", "wholeAccountComplete"],
        "properties": {
          "contractVersion": {
            "const": "cop-sim-user-data-v1"
          },
          "component": {
            "const": "sim_user_data"
          },
          "scope": {
            "const": "cop_sim_shared_identity_v1"
          },
          "resetEpoch": {
            "type": "string",
            "format": "uuid"
          },
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "enum": ["deletion_pending", "deleted"]
          },
          "subcomponents": {
            "type": "object",
            "additionalProperties": false,
            "required": ["app_store", "audit_and_publisher", "router_sim_history"],
            "properties": {
              "app_store": {
                "enum": ["pending", "deleted"]
              },
              "audit_and_publisher": {
                "enum": ["pending", "deleted"]
              },
              "router_sim_history": {
                "enum": ["pending", "deleted"]
              }
            }
          },
          "wholeAccountComplete": {
            "const": false
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contractVersion", "component", "scope", "resetEpoch", "ready", "wholeAccountComplete"],
        "properties": {
          "contractVersion": {
            "const": "cop-sim-user-data-v1"
          },
          "component": {
            "const": "sim_user_data"
          },
          "scope": {
            "const": "cop_sim_shared_identity_v1"
          },
          "resetEpoch": {
            "type": "string",
            "format": "uuid"
          },
          "ready": {
            "type": "boolean"
          },
          "wholeAccountComplete": {
            "const": false
          }
        }
      },
      "HistoryCapabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contractVersion", "component", "scope", "resetEpoch", "ready", "wholeAccountComplete"],
        "properties": {
          "contractVersion": {
            "const": "cop-sim-user-data-v1"
          },
          "component": {
            "const": "sim_router_history"
          },
          "scope": {
            "const": "cop_sim_shared_identity_v1"
          },
          "resetEpoch": {
            "type": "string",
            "format": "uuid"
          },
          "ready": {
            "type": "boolean"
          },
          "wholeAccountComplete": {
            "const": false
          }
        }
      },
      "HistoryReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contractVersion", "component", "scope", "resetEpoch", "operationId", "state", "wholeAccountComplete", "remainingRecords"],
        "properties": {
          "contractVersion": {
            "const": "cop-sim-user-data-v1"
          },
          "component": {
            "const": "sim_router_history"
          },
          "scope": {
            "const": "cop_sim_shared_identity_v1"
          },
          "resetEpoch": {
            "type": "string",
            "format": "uuid"
          },
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "enum": ["deletion_pending", "deleted"]
          },
          "wholeAccountComplete": {
            "const": false
          },
          "remainingRecords": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "null while pending; exact fresh SQL zero only after deletion"
          }
        }
      }
    },
    "securitySchemes": {
      "Service": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated COP service token; not an end-user or existing legacy token"
      },
      "Actor": {
        "type": "apiKey",
        "in": "header",
        "name": "x-cop-clean-actor",
        "description": "Canonical base64url signed exact 13-claim COP actor: iss,aud,sub,oidcIssuer,oidcSubject,resetEpoch,operationId,requestedAt,iat,exp,jti,resourceId,oidcIat. aud=sim-clean-lifecycle-v1. Stable verified issuer + UUID subject, original OIDC iat after epoch cutoff; no display identity."
      },
      "Signature": {
        "type": "apiKey",
        "in": "header",
        "name": "x-cop-clean-actor-signature",
        "description": "HMAC-SHA256 of x-cop-clean-actor with new dedicated actor secret. Must match exact operation/time/epoch and canonical original OIDC identity."
      },
      "HistoryService": {
        "type": "http",
        "scheme": "bearer",
        "description": "Existing authenticated SIM service token, distinct from new COP-to-main token"
      },
      "HistoryActor": {
        "type": "apiKey",
        "in": "header",
        "name": "x-sim-user-actor",
        "description": "Exact canonical base64url claims iss=sim-app,aud=sim-user-history-v1,ownerKey,resetEpoch,oidcIat,iat,exp,jti plus operationId/requestedAt for deletion. Derived only by verified main canonical OIDC path."
      },
      "HistorySignature": {
        "type": "apiKey",
        "in": "header",
        "name": "x-sim-user-actor-signature",
        "description": "HMAC-SHA256 of x-sim-user-actor under the distinct main-to-Router actor secret; maximum 60s lifetime."
      }
    }
  }
}
