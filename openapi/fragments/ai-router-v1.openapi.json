{
  "openapi": "3.1.0",
  "info": { "title": "SIM internal AI Router v1", "version": "0.1.0" },
  "paths": {
    "/api/v1/ai-router/models": {
      "get": {
        "tags": ["AI Router"],
        "operationId": "aiRouterModels",
        "summary": "List configured internal model tiers",
        "servers": [{ "url": "http://ai-router-api:4050" }],
        "security": [{ "aiRouterBearer": [] }],
        "responses": {
          "200": {
            "description": "Enabled model tiers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "models": { "type": "array", "items": { "type": "object" } }, "policy": { "type": "object" } },
                  "required": ["models", "policy"]
                }
              }
            }
          },
          "401": { "description": "Missing internal token" }
        }
      }
    },
    "/api/v1/ai-router/usage": {
      "get": {
        "tags": ["AI Router"],
        "operationId": "aiRouterUsage",
        "summary": "Read router-only budget usage (admin)",
        "servers": [{ "url": "http://ai-router-api:4050" }],
        "security": [{ "aiRouterBearer": [] }],
        "responses": {
          "200": {
            "description": "Current UTC day and month usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "dailyMicrousd": { "type": "integer" },
                    "monthlyMicrousd": { "type": "integer" },
                    "dailyRequests": { "type": "integer" },
                    "limits": { "type": "object" }
                  },
                  "required": ["dailyMicrousd", "monthlyMicrousd", "dailyRequests", "limits"]
                }
              }
            }
          },
          "401": { "description": "Missing internal token" },
          "403": { "description": "Admin identity required" }
        }
      }
    },
    "/api/v1/ai-router/policy": {
      "get": {
        "tags": ["AI Router"],
        "operationId": "aiRouterPolicy",
        "summary": "Read active model and budget policy",
        "servers": [{ "url": "http://ai-router-api:4050" }],
        "security": [{ "aiRouterBearer": [] }],
        "responses": {
          "200": { "description": "Active policy", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiRouterPolicy" } } } },
          "401": { "description": "Missing internal token" }
        }
      },
      "patch": {
        "tags": ["AI Router"],
        "operationId": "aiRouterUpdatePolicy",
        "summary": "Update policy within environment hard caps (admin)",
        "servers": [{ "url": "http://ai-router-api:4050" }],
        "security": [{ "aiRouterBearer": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiRouterPolicy" } } } },
        "responses": {
          "200": { "description": "Saved policy", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiRouterPolicy" } } } },
          "400": { "description": "Invalid policy" },
          "403": { "description": "Admin required" },
          "503": { "description": "Policy store unavailable" }
        }
      }
    },
    "/api/v1/ai/router-admin": {
      "get": {
        "tags": ["Simulator: AI"],
        "operationId": "simAiRouterAdmin",
        "summary": "SIM AI admin view of models, policy and router-only usage",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Admin snapshot", "content": { "application/json": { "schema": { "type": "object" } } } },
          "403": { "description": "SIM AI admin role required" },
          "503": { "description": "Router unavailable" }
        }
      }
    },
    "/api/v1/ai/router-admin/policy": {
      "patch": {
        "tags": ["Simulator: AI"],
        "operationId": "simAiRouterAdminPolicy",
        "summary": "Save router policy through authenticated SIM admin proxy",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiRouterPolicy" } } } },
        "responses": {
          "200": { "description": "Saved policy", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiRouterPolicy" } } } },
          "403": { "description": "SIM AI admin role required" },
          "503": { "description": "Router unavailable" }
        }
      }
    },
    "/api/v1/ai/router-scenario-preview": {
      "post": {
        "tags": ["Simulator: AI"],
        "operationId": "simAiRouterScenarioPreview",
        "summary": "Generate a human-reviewed text preview for a synthetic SIM exercise",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["prompt", "syntheticOnly"],
                "properties": { "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 }, "syntheticOnly": { "type": "boolean", "const": true } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Advisory text, model and router usage; never creates a SIM scenario",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiRouterGenerateResponse" } } }
          },
          "400": { "description": "Invalid or non-synthetic request" },
          "403": { "description": "SIM AI user role required" },
          "429": { "description": "Router budget or user limit reached" },
          "503": { "description": "Router unavailable" }
        }
      }
    },
    "/api/v1/ai-router/generate": {
      "post": {
        "tags": ["AI Router"],
        "operationId": "aiRouterGenerate",
        "summary": "Route a bounded authorized AI request; COP chat external processing requires a reviewed typed context",
        "servers": [{ "url": "http://ai-router-api:4050" }],
        "security": [{ "aiRouterBearer": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiRouterGenerateRequest" } } } },
        "responses": {
          "200": {
            "description": "Assistive answer with cost estimate and routing reason",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiRouterGenerateResponse" } } }
          },
          "400": { "description": "Invalid or missing classification/context, unapproved external processing, or forbidden COP escalation" },
          "401": { "description": "Missing internal token" },
          "403": { "description": "Task not allowed for consumer" },
          "429": { "description": "Budget or user limit exceeded" },
          "503": { "description": "Policy, selected model or budget/audit store unavailable; no direct-provider fallback" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "aiRouterBearer": { "type": "http", "scheme": "bearer" } },
    "schemas": {
      "AiRouterPolicy": {
        "type": "object",
        "required": ["externalAllowed", "advancedAllowed", "limits"],
        "properties": {
          "externalAllowed": { "type": "boolean" },
          "advancedAllowed": { "type": "boolean" },
          "limits": {
            "type": "object",
            "required": ["dailyMicrousd", "monthlyMicrousd", "perUserDailyRequests"],
            "properties": {
              "dailyMicrousd": { "type": "integer", "minimum": 1 },
              "monthlyMicrousd": { "type": "integer", "minimum": 1 },
              "perUserDailyRequests": { "type": "integer", "minimum": 1 }
            }
          }
        }
      },
      "AiRouterGenerateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskType", "dataClass", "prompt", "userId"],
        "allOf": [
          {
            "if": { "properties": { "taskType": { "const": "cop_chat" } }, "required": ["taskType"] },
            "then": {
              "required": ["copContext"],
              "properties": {
                "prompt": { "maxLength": 1200 },
                "userId": { "pattern": "^[A-Za-z0-9_-]{8,128}$" },
                "allowPaidEscalation": { "not": { "const": true } }
              }
            }
          },
          {
            "if": { "properties": { "taskType": { "const": "cop_chat" }, "dataClass": { "const": "internal" } }, "required": ["taskType", "dataClass"] },
            "then": { "properties": { "copContext": { "$ref": "#/components/schemas/AiRouterCopInternalContext" }, "allowExternal": { "not": { "const": true } } } }
          },
          {
            "if": { "properties": { "taskType": { "const": "cop_chat" }, "dataClass": { "const": "synthetic" } }, "required": ["taskType", "dataClass"] },
            "then": { "properties": { "copContext": { "$ref": "#/components/schemas/AiRouterCopSyntheticContext" } } }
          },
          {
            "if": { "properties": { "taskType": { "const": "cop_chat" }, "dataClass": { "const": "public_aggregate" } }, "required": ["taskType", "dataClass"] },
            "then": { "properties": { "copContext": { "$ref": "#/components/schemas/AiRouterCopPublicAggregateContext" } } }
          },
          {
            "if": { "properties": { "taskType": { "const": "cop_chat" }, "preference": { "const": "external" } }, "required": ["taskType", "preference"] },
            "then": { "required": ["allowExternal"], "properties": { "allowExternal": { "const": true } } }
          }
        ],
        "properties": {
          "taskType": { "type": "string", "enum": ["cop_chat", "source_health", "sim_scenario"] },
          "dataClass": { "type": "string", "enum": ["synthetic", "public_aggregate", "internal"] },
          "preference": { "type": "string", "enum": ["auto", "local", "external"] },
          "prompt": { "type": "string", "minLength": 1, "maxLength": 12000, "description": "For cop_chat, a COP-reviewed question of at most 1200 characters, never raw conversation history or free-form situational context." },
          "userId": { "type": "string", "minLength": 1, "maxLength": 200, "description": "For cop_chat, a stable opaque 8-128 character identifier matching [A-Za-z0-9_-]; no name or email. Router hashes it before storage." },
          "allowExternal": { "type": "boolean", "default": false },
          "allowPaidEscalation": { "type": "boolean", "default": false, "description": "Forbidden for cop_chat; reviewed external COP requests may only use gpt-6-luna." },
          "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 1024 },
          "copContext": { "$ref": "#/components/schemas/AiRouterCopContext" }
        }
      },
      "AiRouterCopContext": {
        "description": "Required for cop_chat. dataClass must exactly equal the request dataClass. External synthetic/public_aggregate requests also require allowExternal=true and a COP policy attestation. Internal is local only.",
        "oneOf": [
          { "$ref": "#/components/schemas/AiRouterCopInternalContext" },
          { "$ref": "#/components/schemas/AiRouterCopSyntheticContext" },
          { "$ref": "#/components/schemas/AiRouterCopPublicAggregateContext" }
        ]
      },
      "AiRouterCopInternalContext": {
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "dataClass"],
        "properties": { "contractVersion": { "const": "cop-chat-context-v1" }, "dataClass": { "const": "internal" } }
      },
      "AiRouterCopSyntheticContext": {
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "dataClass", "attestation", "scenarioId", "facts"],
        "properties": {
          "contractVersion": { "const": "cop-chat-context-v1" }, "dataClass": { "const": "synthetic" },
          "attestation": { "const": "cop-policy-reviewed-v1" },
          "scenarioId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
          "facts": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 240 } }
        }
      },
      "AiRouterCopPublicAggregateContext": {
        "type": "object", "additionalProperties": false,
        "required": ["contractVersion", "dataClass", "attestation", "aggregates"],
        "properties": {
          "contractVersion": { "const": "cop-chat-context-v1" }, "dataClass": { "const": "public_aggregate" },
          "attestation": { "const": "cop-policy-reviewed-v1" },
          "aggregates": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/components/schemas/AiRouterCopAggregate" } }
        }
      },
      "AiRouterCopAggregate": {
        "type": "object", "additionalProperties": false,
        "required": ["sourceId", "metricId", "regionCode", "periodStart", "periodEnd", "value", "unit", "sampleSize"],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
          "metricId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
          "regionCode": { "type": "string", "pattern": "^CZ([0-9]{3})?$", "description": "Country or NUTS3 region only; no precise locations." },
          "periodStart": { "type": "string", "format": "date-time" },
          "periodEnd": { "type": "string", "format": "date-time", "description": "At least one hour after periodStart." },
          "value": { "type": "number" },
          "unit": { "type": "string", "enum": ["count", "percent", "minutes", "km", "index"] },
          "sampleSize": { "type": "integer", "minimum": 10 }
        }
      },
      "AiRouterGenerateResponse": {
        "type": "object",
        "required": ["requestId", "model", "tier", "routingReason", "difficulty", "output", "usage", "requiresHumanReview"],
        "properties": {
          "requestId": { "type": "string", "format": "uuid" },
          "model": { "type": "string" },
          "tier": { "type": "string" },
          "routingReason": { "type": "string" },
          "difficulty": { "type": "string" },
          "output": { "type": "string" },
          "usage": { "type": "object" },
          "requiresHumanReview": { "type": "boolean", "const": true }
        }
      }
    }
  }
}
