{
  "Coordinate": {
    "type": "object",
    "additionalProperties": false,
    "required": ["lon", "lat"],
    "properties": { "lon": { "type": "number", "minimum": -180, "maximum": 180 }, "lat": { "type": "number", "minimum": -90, "maximum": 90 } }
  },
  "Trailer": {
    "type": "object",
    "additionalProperties": false,
    "required": ["attached", "heightM", "widthM", "lengthM", "loadedWeightKg"],
    "properties": {
      "attached": { "const": true },
      "heightM": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
      "widthM": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
      "lengthM": { "type": "number", "exclusiveMinimum": 0, "maximum": 25 },
      "loadedWeightKg": { "type": "number", "exclusiveMinimum": 0, "maximum": 60000 }
    }
  },
  "Vehicle": {
    "type": "object",
    "additionalProperties": false,
    "required": ["heightM", "widthM", "lengthM", "loadedWeightKg"],
    "properties": {
      "heightM": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
      "widthM": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
      "lengthM": { "type": "number", "exclusiveMinimum": 0, "maximum": 25 },
      "loadedWeightKg": { "type": "number", "exclusiveMinimum": 0, "maximum": 60000 },
      "axleLoadKg": { "type": "number", "exclusiveMinimum": 0, "maximum": 40000 },
      "axleCount": { "type": "integer", "minimum": 2, "maximum": 20 },
      "trailer": { "$ref": "#/components/schemas/Trailer" }
    }
  },
  "Profile": {
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "intent", "coverageAcknowledged"],
    "properties": {
      "version": { "const": "sim-mapped-road-profile-v1" },
      "intent": { "enum": ["car", "commercial_truck", "car_with_trailer", "road_legal_4x4"] },
      "coverageAcknowledged": { "const": "mapped_restrictions_incomplete" },
      "vehicle": { "$ref": "#/components/schemas/Vehicle" },
      "driverDeclaredAuthorization": {
        "type": "boolean",
        "description": "False is ordinary mapped access. True requests a scoped private-access exemption, currently unsupported (422), never blanket ignore_access."
      }
    },
    "allOf": [
      { "if": { "properties": { "intent": { "enum": ["commercial_truck", "car_with_trailer"] } } }, "then": { "required": ["vehicle"] } },
      {
        "if": { "properties": { "intent": { "const": "car_with_trailer" } } },
        "then": { "properties": { "vehicle": { "required": ["trailer"] } } },
        "else": { "properties": { "vehicle": { "not": { "required": ["trailer"] } } } }
      }
    ]
  },
  "LastMile": {
    "type": "object",
    "additionalProperties": false,
    "required": ["state", "target", "mappedEndpoint", "distanceM"],
    "properties": {
      "state": { "enum": ["mapped_target", "target_guidance_only"] },
      "target": { "$ref": "#/components/schemas/Coordinate" },
      "mappedEndpoint": { "$ref": "#/components/schemas/Coordinate" },
      "distanceM": { "type": "number", "minimum": 0, "maximum": 25 }
    },
    "description": "Geometry/steps stop at mappedEndpoint. Any displaced target is guidance only, never an appended traversable segment. More than 25m is rejected, not silently snapped."
  },
  "Assessment": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "version",
      "state",
      "coverage",
      "appliedProfile",
      "profileHash",
      "requestHash",
      "geometryHash",
      "engine",
      "routingDataset",
      "appliedFields",
      "validUntil",
      "lastMile",
      "limitations"
    ],
    "properties": {
      "version": { "const": "sim-mapped-road-profile-assessment-v1" },
      "state": { "const": "applied" },
      "coverage": { "const": "mapped_restrictions_incomplete" },
      "appliedProfile": { "$ref": "#/components/schemas/Profile" },
      "profileHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "requestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "geometryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "engine": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "version", "costing", "fallbackUsed"],
        "properties": {
          "provider": { "const": "valhalla" },
          "version": { "const": "3.8.3" },
          "costing": { "enum": ["auto", "truck"] },
          "fallbackUsed": { "const": false }
        }
      },
      "routingDataset": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "builtAt"],
        "properties": { "version": { "type": "string", "minLength": 1, "maxLength": 128 }, "builtAt": { "type": "string", "format": "date-time" } }
      },
      "appliedFields": {
        "type": "array",
        "uniqueItems": true,
        "items": { "enum": ["heightM", "widthM", "lengthM", "loadedWeightKg", "axleLoadKg", "axleCount", "road_first_preference"] }
      },
      "validUntil": { "type": "string", "format": "date-time" },
      "lastMile": { "$ref": "#/components/schemas/LastMile" },
      "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
    }
  },
  "Capabilities": {
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "availability", "intents", "maxSnapDistanceM", "driverDeclaredAuthorization", "unmappedLastMile", "strictGuarantees"],
    "properties": {
      "version": { "const": "sim-mapped-road-profile-capabilities-v1" },
      "availability": { "enum": ["requires_runtime_validation", "disabled"] },
      "intents": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intent", "costing", "supportedFields", "limitations"],
          "properties": {
            "intent": { "enum": ["car", "commercial_truck", "car_with_trailer", "road_legal_4x4"] },
            "costing": { "enum": ["auto", "truck"] },
            "supportedFields": { "type": "array", "items": { "type": "string" } },
            "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      },
      "maxSnapDistanceM": { "const": 25 },
      "driverDeclaredAuthorization": { "const": "unsupported" },
      "unmappedLastMile": { "const": "unsupported" },
      "strictGuarantees": { "const": false }
    }
  }
}
