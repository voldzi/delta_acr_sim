{
  "openapi": "3.1.0",
  "info": {
    "title": "SIM assisted planning origin",
    "version": "1.0.0",
    "description": "Joint-frozen source contract. Runtime disabled unless authenticated cop principal is explicitly allowed; deployment and physical acceptance remain separate."
  },
  "x-status": "source-implementation-not-production-accepted",
  "x-limits": {
    "candidateLocateRequests": 1,
    "candidateSearchRadiusM": 500,
    "candidateCount": 3,
    "previewRouteComputations": 1,
    "implicitRetries": 0
  },
  "x-authority": "Existing authenticated COP service and trusted user identity; no client-selected account, token or new secret.",
  "paths": {
    "/api/v1/routing/planning-origin/candidates": {
      "post": {
        "operationId": "planningOriginCandidates",
        "summary": "Suggest bounded unverified planning origin points",
        "security": [
          {
            "ExistingCopServiceAuth": []
          }
        ],
        "parameters": [
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-COP-Planning-Actor",
            "in": "header",
            "required": true,
            "description": "NEW service assertion: only accepted after authorized COP service-principal authentication. COP overwrites it from verified session, never copies client values. Opaque quota/request binding, not a user access grant.",
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CandidatesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Candidate suggestions or accepted preview; never navigation authority",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandidatesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Strict validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Existing scoped service authentication failed before any engine request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Context/dataset/selection binding changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Context expired or unchanged route guards rejected result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Existing service/user rate budget exhausted; no fallback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Capacity, graph, closure or engine unavailable; no fallback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/routing/planning-origin/preview": {
      "post": {
        "operationId": "planningOriginPreview",
        "summary": "Compute a purpose-bound planning preview without navigation authority",
        "security": [
          {
            "ExistingCopServiceAuth": []
          }
        ],
        "parameters": [
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-COP-Planning-Actor",
            "in": "header",
            "required": true,
            "description": "NEW service assertion: only accepted after authorized COP service-principal authentication. COP overwrites it from verified session, never copies client values. Opaque quota/request binding, not a user access grant.",
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Candidate suggestions or accepted preview; never navigation authority",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreviewResponse"
                }
              }
            }
          },
          "400": {
            "description": "Strict validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Existing scoped service authentication failed before any engine request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Context/dataset/selection binding changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Context expired or unchanged route guards rejected result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Existing service/user rate budget exhausted; no fallback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Capacity, graph, closure or engine unavailable; no fallback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ExistingCopServiceAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "PROPOSED scope extension of existing geo-routing Bearer-to-service-principal lookup; NOT existing ordinary routing auth. New planning-service actor allowlist defaults deny. Reuse a legitimate existing server credential only after scoped review; no new secret or transfer authorized by this proposal."
      }
    },
    "schemas": {
      "Coordinate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lat",
          "lon"
        ],
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "PhoneOrigin": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "coordinate",
          "horizontalAccuracyM",
          "observedAt",
          "accuracyAuthorization"
        ],
        "properties": {
          "kind": {
            "const": "phone_measured"
          },
          "coordinate": {
            "$ref": "#/components/schemas/Coordinate"
          },
          "horizontalAccuracyM": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 5000
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "accuracyAuthorization": {
            "enum": [
              "full",
              "reduced"
            ]
          }
        }
      },
      "ManualOrigin": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "coordinate",
          "source"
        ],
        "properties": {
          "kind": {
            "const": "manual_point"
          },
          "coordinate": {
            "$ref": "#/components/schemas/Coordinate"
          },
          "source": {
            "enum": [
              "user_map_selection",
              "user_selected_last_known",
              "address_selection"
            ]
          }
        }
      },
      "OriginContext": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/PhoneOrigin"
          },
          {
            "$ref": "#/components/schemas/ManualOrigin"
          }
        ],
        "discriminator": {
          "propertyName": "kind"
        }
      },
      "Context": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "purpose",
          "contextId",
          "originContext",
          "destination",
          "vehicleProfile"
        ],
        "properties": {
          "version": {
            "const": "sim-planning-origin-v1"
          },
          "purpose": {
            "const": "planning_preview"
          },
          "contextId": {
            "type": "string",
            "format": "uuid"
          },
          "originContext": {
            "$ref": "#/components/schemas/OriginContext"
          },
          "destination": {
            "$ref": "#/components/schemas/Coordinate"
          },
          "vehicleProfile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "intent",
              "coverageAcknowledged"
            ],
            "properties": {
              "version": {
                "const": "sim-mapped-road-profile-v1"
              },
              "intent": {
                "enum": [
                  "car",
                  "commercial_truck",
                  "car_with_trailer",
                  "road_legal_4x4"
                ]
              },
              "coverageAcknowledged": {
                "const": "mapped_restrictions_incomplete"
              },
              "vehicle": {
                "$ref": "#/components/schemas/SharedMappedRoadProfileVehicle"
              },
              "driverDeclaredAuthorization": {
                "type": "boolean",
                "description": "False is ordinary mapped access. True requests a scoped private-access exemption, currently unsupported (422), never blanket ignore_access."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "intent": {
                      "enum": [
                        "commercial_truck",
                        "car_with_trailer"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "vehicle"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "intent": {
                      "const": "car_with_trailer"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "vehicle": {
                      "required": [
                        "trailer"
                      ]
                    }
                  }
                },
                "else": {
                  "properties": {
                    "vehicle": {
                      "not": {
                        "required": [
                          "trailer"
                        ]
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "Dataset": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "builtAt"
        ],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "builtAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Binding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contextId",
          "requestHash",
          "contextHash",
          "profileHash",
          "destinationHash",
          "routingDataset"
        ],
        "properties": {
          "contextId": {
            "type": "string",
            "format": "uuid"
          },
          "requestHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "contextHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "profileHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "destinationHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "routingDataset": {
            "$ref": "#/components/schemas/Dataset"
          }
        }
      },
      "Candidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateId",
          "coordinate",
          "offsetDistanceM",
          "profileValidation",
          "legalAccess",
          "directionValidation",
          "directions",
          "directionsTruncated"
        ],
        "properties": {
          "candidateId": {
            "type": "string",
            "pattern": "^candidate:[a-f0-9]{64}$"
          },
          "coordinate": {
            "$ref": "#/components/schemas/Coordinate"
          },
          "offsetDistanceM": {
            "type": "number",
            "minimum": 0,
            "maximum": 500
          },
          "profileValidation": {
            "const": "not_checked"
          },
          "legalAccess": {
            "const": "not_verified"
          },
          "directionValidation": {
            "const": "graph_candidate_only"
          },
          "directions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/CandidateDirection"
            }
          },
          "directionsTruncated": {
            "type": "boolean"
          }
        }
      },
      "CandidatesRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context"
        ],
        "properties": {
          "context": {
            "$ref": "#/components/schemas/Context"
          }
        }
      },
      "CandidatesResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "purpose",
          "state",
          "binding",
          "observedAt",
          "validUntil",
          "candidates",
          "navigationEligible",
          "measurementEligible"
        ],
        "properties": {
          "version": {
            "const": "sim-planning-origin-candidates-v1"
          },
          "purpose": {
            "const": "planning_preview"
          },
          "state": {
            "enum": [
              "choices_available",
              "no_candidates"
            ]
          },
          "binding": {
            "$ref": "#/components/schemas/Binding"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          },
          "candidates": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          },
          "navigationEligible": {
            "const": false
          },
          "measurementEligible": {
            "const": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "const": "choices_available"
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "properties": {
                "candidates": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "candidates": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      },
      "Selection": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/CandidateSelection"
          },
          {
            "$ref": "#/components/schemas/ManualSelection"
          }
        ],
        "discriminator": {
          "propertyName": "source"
        }
      },
      "PreviewRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context",
          "expectedDataset",
          "selection",
          "discoveryBinding"
        ],
        "properties": {
          "context": {
            "$ref": "#/components/schemas/Context"
          },
          "expectedDataset": {
            "$ref": "#/components/schemas/Dataset"
          },
          "selection": {
            "$ref": "#/components/schemas/Selection"
          },
          "discoveryBinding": {
            "$ref": "#/components/schemas/Binding"
          }
        }
      },
      "PreviewAssessment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "purpose",
          "binding",
          "selectionHash",
          "geometryHash",
          "validUntil",
          "navigationEligible",
          "measurementEligible",
          "guards",
          "state",
          "coverage",
          "appliedProfile",
          "profileHash",
          "requestHash",
          "engine",
          "routingDataset",
          "appliedFields",
          "lastMile",
          "limitations",
          "knownClosuresEvidence"
        ],
        "properties": {
          "version": {
            "const": "sim-planning-origin-assessment-v1"
          },
          "purpose": {
            "const": "planning_preview"
          },
          "binding": {
            "$ref": "#/components/schemas/Binding"
          },
          "selectionHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "geometryHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          },
          "navigationEligible": {
            "const": false
          },
          "measurementEligible": {
            "const": false
          },
          "guards": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mappedProfile",
              "knownClosures",
              "closureRevision",
              "snapToleranceM",
              "nativeWarningCount",
              "allVariantsValidated",
              "fallbackUsed"
            ],
            "properties": {
              "mappedProfile": {
                "const": "applied_incomplete_coverage"
              },
              "knownClosures": {
                "const": "applied_reviewed_snapshot"
              },
              "closureRevision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "snapToleranceM": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 25
              },
              "nativeWarningCount": {
                "const": 0
              },
              "allVariantsValidated": {
                "const": true
              },
              "fallbackUsed": {
                "const": false
              }
            }
          },
          "state": {
            "const": "applied"
          },
          "coverage": {
            "const": "mapped_restrictions_incomplete"
          },
          "appliedProfile": {
            "$ref": "#/components/schemas/SharedMappedRoadProfileProfile"
          },
          "profileHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "requestHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "engine": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "version",
              "costing",
              "fallbackUsed"
            ],
            "properties": {
              "provider": {
                "const": "valhalla"
              },
              "version": {
                "const": "3.8.3"
              },
              "costing": {
                "enum": [
                  "auto",
                  "truck"
                ]
              },
              "fallbackUsed": {
                "const": false
              }
            }
          },
          "routingDataset": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "builtAt"
            ],
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "builtAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "appliedFields": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "heightM",
                "widthM",
                "lengthM",
                "loadedWeightKg",
                "axleLoadKg",
                "axleCount",
                "road_first_preference"
              ]
            }
          },
          "lastMile": {
            "$ref": "#/components/schemas/SharedMappedRoadProfileLastMile"
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "knownClosuresEvidence": {
            "$ref": "#/components/schemas/KnownClosuresEvidence"
          }
        }
      },
      "PreviewResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "purpose",
          "context",
          "planningOrigin",
          "offsetDistanceM",
          "connector",
          "navigationEligible",
          "measurementEligible",
          "assessment",
          "route"
        ],
        "properties": {
          "version": {
            "const": "sim-planning-origin-preview-v1"
          },
          "purpose": {
            "const": "planning_preview"
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          },
          "planningOrigin": {
            "$ref": "#/components/schemas/Coordinate"
          },
          "offsetDistanceM": {
            "type": "number",
            "minimum": 0
          },
          "connector": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "navigable"
            ],
            "properties": {
              "state": {
                "const": "unknown"
              },
              "navigable": {
                "const": false
              }
            }
          },
          "navigationEligible": {
            "const": false
          },
          "measurementEligible": {
            "const": false
          },
          "assessment": {
            "$ref": "#/components/schemas/PreviewAssessment"
          },
          "route": {
            "$ref": "#/components/schemas/PreviewPath"
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "correlationId",
          "message"
        ],
        "properties": {
          "code": {
            "enum": [
              "UNAUTHORIZED",
              "VALIDATION_ERROR",
              "PLANNING_ORIGIN_CONTEXT_EXPIRED",
              "PLANNING_ORIGIN_DATASET_CHANGED",
              "PLANNING_ORIGIN_SELECTION_INVALID",
              "ROUTING_LOCATION_NOT_ROUTABLE",
              "ROUTING_TARGET_NOT_ROUTABLE",
              "ROUTING_WAYPOINT_NOT_ROUTABLE",
              "ROUTING_RESTRICTIONS_RELAXATION_REQUIRED",
              "PLANNING_ORIGIN_LIMIT_EXCEEDED",
              "ROUTING_BUSY",
              "PLANNING_ORIGIN_UNAVAILABLE",
              "ROUTING_KNOWN_CLOSURES_UNAVAILABLE",
              "ROUTING_KNOWN_CLOSURES_CHANGED",
              "ROUTING_GRAPH_STALE",
              "ROUTING_PROFILE_UNAVAILABLE",
              "ROUTING_KNOWN_CLOSURES_ENGINE_FAILED"
            ]
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "message": {
            "type": "string",
            "maxLength": 512
          }
        }
      },
      "PreviewPath": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "previewPathId",
          "geometry",
          "distanceM",
          "durationSeconds",
          "warnings"
        ],
        "properties": {
          "previewPathId": {
            "type": "string",
            "pattern": "^preview:[a-f0-9]{64}$"
          },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "const": "LineString"
              },
              "coordinates": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    }
                  ],
                  "items": false
                }
              }
            }
          },
          "distanceM": {
            "type": "number",
            "minimum": 0
          },
          "durationSeconds": {
            "type": "number",
            "minimum": 0
          },
          "warnings": {
