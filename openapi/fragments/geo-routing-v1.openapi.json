{
  "openapi": "3.1.0",
  "info": {
    "title": "SIM geo-routing-v1 fragment",
    "version": "1.0.0"
  },
  "paths": {
    "/geo-routing-v1/route": {
      "post": {
        "summary": "Compute an ordered walking or bicycle route",
        "description": "Internal server-to-server operation. Locations are routed in input order. Supplying Idempotency-Key makes publication-time retries return the original route snapshot.",
        "operationId": "computeGeoRoutingV1Route",
        "tags": ["Geo routing"],
        "security": [
          {
            "geoRoutingServiceBearer": []
          }
        ],
        "x-required-scope": "geo-routing:route",
        "x-audience": "csm-sim-geo-routing-v1",
        "x-rate-limit": "60 requests per minute per service identity",
        "x-processing-timeout-ms": 8000,
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "1-128 safe ASCII characters. Reusing the key with a different normalized request returns 409.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "x-max-bytes": 1048576,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeoRoutingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ordered route snapshot",
            "headers": {
              "X-Idempotent-Replay": {
                "description": "true when a persisted response was replayed for Idempotency-Key.",
                "schema": {
                  "type": "string",
                  "enum": ["true", "false"]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoRoutingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or unsupported waypoint optimization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoRoutingErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid service token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoRoutingErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Browser-origin request forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoRoutingErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoRoutingErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Per-service rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoRoutingErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Valhalla or routing dataset metadata unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoRoutingErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "geoRoutingServiceBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque service token",
        "description": "Scoped per-backend service identity. Audience csm-sim-geo-routing-v1; scope geo-routing:route."
      }
    },
    "schemas": {
      "GeoRoutingLocation": {
        "type": "object",
        "required": ["longitude", "latitude"],
        "properties": {
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          }
        },
        "additionalProperties": false
      },
      "GeoRoutingRequest": {
        "type": "object",
        "required": ["contractVersion", "profile", "locations"],
        "properties": {
          "contractVersion": {
            "type": "string",
            "const": "geo-routing-v1"
          },
          "profile": {
            "type": "string",
            "enum": ["walking", "bicycle"]
          },
          "locations": {
            "type": "array",
            "minItems": 2,
            "maxItems": 25,
            "items": {
              "$ref": "#/components/schemas/GeoRoutingLocation"
            }
          },
          "options": {
            "type": "object",
            "properties": {
              "elevation": {
                "type": "boolean",
                "const": true,
                "default": true
              },
              "optimizeWaypointOrder": {
                "type": "boolean",
                "const": false,
                "default": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "GeoRoutingResponse": {
        "type": "object",
        "required": ["contractVersion", "profile", "waypointOrder", "geometry", "summary", "routingDataset", "computedAt"],
        "properties": {
          "contractVersion": {
            "type": "string",
            "const": "geo-routing-v1"
          },
          "profile": {
            "type": "string",
            "enum": ["walking", "bicycle"]
          },
          "waypointOrder": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": {
                "type": "string",
                "const": "LineString"
              },
              "coordinates": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "array",
                  "prefixItems": [
                    { "type": "number", "minimum": -180, "maximum": 180 },
                    { "type": "number", "minimum": -90, "maximum": 90 }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "additionalProperties": false
          },
          "summary": {
            "type": "object",
            "required": ["distanceM", "durationSeconds", "elevationGainM", "elevationLossM"],
            "properties": {
              "distanceM": { "type": "number", "minimum": 0 },
              "durationSeconds": { "type": "number", "minimum": 0 },
              "elevationGainM": { "type": "number", "minimum": 0 },
              "elevationLossM": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "routingDataset": {
            "type": "object",
            "required": ["version", "builtAt"],
            "properties": {
              "version": { "type": "string", "minLength": 1 },
              "builtAt": { "type": "string", "format": "date-time" }
            },
            "additionalProperties": false
          },
          "computedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "GeoRoutingErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "correlationId"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "correlationId": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  }
}
