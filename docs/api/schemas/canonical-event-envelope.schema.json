{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/sim/canonical-event-envelope.schema.json",
  "title": "Canonical Event Envelope",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "contractVersion",
    "source",
    "producerTimestamp",
    "classification",
    "payload",
    "quality",
    "simulation"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "track.created",
        "track.updated",
        "track.lost",
        "track.restored",
        "track.deleted",
        "incident.created",
        "incident.updated",
        "report.created",
        "source.status.changed"
      ]
    },
    "contractVersion": {
      "const": "cop-ingest-v1"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "object",
      "required": [
        "sourceSystemId",
        "adapterId",
        "adapterVersion"
      ],
      "properties": {
        "sourceSystemId": {
          "type": "string"
        },
        "sourceDeviceId": {
          "type": "string"
        },
        "adapterId": {
          "type": "string"
        },
        "adapterVersion": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "producerTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sequence": {
      "type": "object",
      "properties": {
        "streamId": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "required": [
        "level",
        "handlingCaveats"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "UNCLASSIFIED",
            "RESTRICTED",
            "CONFIDENTIAL"
          ]
        },
        "releasability": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "handlingCaveats": {
          "type": "array",
          "contains": {
            "const": "SYNTHETIC"
          },
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "geo": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitudeM": {
          "type": "number"
        },
        "accuracyM": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "required": [
        "objectId",
        "objectType",
        "status"
      ],
      "properties": {
        "objectId": {
          "type": "string"
        },
        "objectType": {
          "type": "string",
          "enum": [
            "AIRCRAFT",
            "UAV",
            "MISSILE_TRACK",
            "GROUND_UNIT",
            "RESCUE_ASSET",
            "INCIDENT",
            "REPORT",
            "UNKNOWN"
          ]
        },
        "affiliation": {
          "type": "string",
          "enum": [
            "FRIEND",
            "ASSUMED_FRIEND",
            "NEUTRAL",
            "UNKNOWN",
            "SUSPECT",
            "HOSTILE",
            "PENDING"
          ]
        },
        "domain": {
          "type": "string",
          "enum": [
            "AIR",
            "LAND",
            "SEA",
            "RESCUE",
            "OTHER"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "INACTIVE",
            "LOST",
            "STALE",
            "CONFLICTED"
          ]
        },
        "speedMps": {
          "type": "number"
        },
        "headingDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "verticalRateMps": {
          "type": "number"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sourceReliability": {
          "type": "string"
        },
        "informationCredibility": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "simulation": {
      "type": "object",
      "required": [
        "synthetic",
        "scenarioId",
        "blockId",
        "seed"
      ],
      "properties": {
        "synthetic": {
          "const": true
        },
        "scenarioId": {
          "type": "string"
        },
        "blockId": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "properties": {
        "signed": {
          "type": "boolean"
        },
        "keyId": {
          "type": [
            "string",
            "null"
          ]
        },
        "algorithm": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
